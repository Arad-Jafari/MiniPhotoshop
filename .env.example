# Django (local development only)
DEBUG=True
SECRET_KEY=replace-with-a-random-django-secret
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# The default app database is SQLite. Set USE_POSTGRES=True only if you
# configure a PostgreSQL database for the Django application.
USE_POSTGRES=False
DB_NAME=photo_editor
DB_USER=postgres
DB_PASSWORD=replace-me
DB_HOST=localhost
DB_PORT=5432

# SQL Server FILESTREAM is required by the configured media storage backend.
SQLSERVER_DB_NAME=Photo_editor_database
SQLSERVER_USER=
SQLSERVER_PASSWORD=
SQLSERVER_HOST=localhost
SQLSERVER_PORT=
SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server

# Local Keycloak / OIDC. The client secret must match the value in
# keycloak/django-dev-realm.json.
OIDC_RP_CLIENT_ID=django-web
OIDC_RP_CLIENT_SECRET=replace-me-with-a-generated-secret
OIDC_RP_SIGN_ALGO=RS256
OIDC_RP_SCOPES=openid email profile
OIDC_REDIRECT_URI=http://localhost:8000/oidc/callback/
OIDC_OP_ISSUER=http://localhost:8080/realms/imagedjango-dev
OIDC_OP_AUTHORIZATION_ENDPOINT=http://localhost:8080/realms/imagedjango-dev/protocol/openid-connect/auth
OIDC_OP_TOKEN_ENDPOINT=http://localhost:8080/realms/imagedjango-dev/protocol/openid-connect/token
OIDC_OP_USER_ENDPOINT=http://localhost:8080/realms/imagedjango-dev/protocol/openid-connect/userinfo
OIDC_OP_JWKS_ENDPOINT=http://localhost:8080/realms/imagedjango-dev/protocol/openid-connect/certs
OIDC_OP_LOGOUT_ENDPOINT=http://localhost:8080/realms/imagedjango-dev/protocol/openid-connect/logout

# Local-only credentials used by docker-compose.yml.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-this-local-only
KEYCLOAK_DB_PASSWORD=change-this-local-only
